<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_2_3_10" targetNamespace="http://paopizza.vn/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <bpmn:collaboration id="Collaboration_2_3_10">
    <bpmn:participant id="Participant_Actor_2_3_10" name="A&#10;Nhân viên / Quản lý" processRef="Process_Actor_2_3_10" />
    <bpmn:participant id="Participant_System_2_3_10" name="B&#10;Hệ thống PaoPizza" processRef="Process_System_2_3_10" />
    <bpmn:messageFlow id="Message_Request_2_3_10" name="Yêu cầu cập nhật trạng thái Hoàn thành" sourceRef="Actor_2_3_10_action" targetRef="System_2_3_10_start" />
    <bpmn:messageFlow id="Message_Response_2_3_10" name="Trạng thái đơn hàng đã cập nhật" sourceRef="System_2_3_10_result" targetRef="Actor_2_3_10_receive" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Actor_2_3_10" isExecutable="false">
    <bpmn:startEvent id="Actor_2_3_10_start" name="Bắt đầu" />
    <bpmn:userTask id="Actor_2_3_10_action" name="A1 Cập nhật trạng thái đơn hàng thành Hoàn thành" />
    <bpmn:sequenceFlow id="Actor_2_3_10_Flow_1" sourceRef="Actor_2_3_10_start" targetRef="Actor_2_3_10_action" />
    <bpmn:sequenceFlow id="Actor_2_3_10_Flow_2" sourceRef="Actor_2_3_10_action" targetRef="Actor_2_3_10_receive" />
    <bpmn:userTask id="Actor_2_3_10_receive" name="A2 Nhận trạng thái đơn hàng đã cập nhật" />
    <bpmn:endEvent id="Actor_2_3_10_end" name="Kết thúc" />
    <bpmn:sequenceFlow id="Actor_2_3_10_Flow_3" sourceRef="Actor_2_3_10_receive" targetRef="Actor_2_3_10_end" />
  </bpmn:process>
  <bpmn:process id="Process_System_2_3_10" isExecutable="false">
    <bpmn:documentation>Khi Frontend nhận yêu cầu cập nhật đơn hàng sang trạng thái Hoàn thành, Frontend gửi yêu cầu đến Backend. Backend cập nhật đơn hàng theo điều kiện chỉ lần chuyển sang Hoàn thành đầu tiên mới thực hiện trừ kho, tránh trừ lặp. Database truy vấn recipe của biến thể sản phẩm, recipe của các sản phẩm được chọn trong combo và định lượng extra topping. Backend quy đổi về đơn vị tồn kho, cộng gộp số lượng theo từng nguyên liệu và tính tồn kho mới. Database lưu tồn kho mới, cho phép số lượng âm, rồi Backend trả trạng thái đơn hàng đã cập nhật để Frontend hiển thị.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_10">
      <bpmn:lane id="Lane_Database_2_3_10" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_10_update_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_load_inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_save_inventory</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_10" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_10_receive_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_load_recipe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_aggregate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_calculate_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Frontend_2_3_10" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_10_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_10_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="System_2_3_10_start" name="Nhận yêu cầu cập nhật trạng thái Hoàn thành">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_10_start" />
    </bpmn:startEvent>
    <bpmn:task id="System_2_3_10_request" name="B1.1 Gửi yêu cầu cập nhật trạng thái đến Backend" />
    <bpmn:serviceTask id="System_2_3_10_receive_request" name="B2.1 Nhận yêu cầu cập nhật trạng thái Hoàn thành" />
    <bpmn:serviceTask id="System_2_3_10_update_order" name="B3.1 Cập nhật đơn sang Hoàn thành">
      <bpmn:outgoing>Flow_1hsta3u</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="System_2_3_10_load_recipe" name="B2.2 Lấy recipe sản phẩm, món trong combo và định lượng extra topping">
      <bpmn:incoming>Flow_1hsta3u</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="System_2_3_10_Flow_1" sourceRef="System_2_3_10_start" targetRef="System_2_3_10_request" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_2" sourceRef="System_2_3_10_request" targetRef="System_2_3_10_receive_request" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_3" sourceRef="System_2_3_10_receive_request" targetRef="System_2_3_10_update_order" />
    <bpmn:sequenceFlow id="Flow_1hsta3u" sourceRef="System_2_3_10_update_order" targetRef="System_2_3_10_load_recipe" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_7" sourceRef="System_2_3_10_load_recipe" targetRef="System_2_3_10_aggregate" />
    <bpmn:serviceTask id="System_2_3_10_aggregate" name="B2.3 Tính tổng lượng từng nguyên liệu cần trừ">
      <bpmn:incoming>System_2_3_10_Flow_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="System_2_3_10_load_inventory" name="B3.3 Truy vấn tồn kho nguyên liệu của cửa hàng" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_9" sourceRef="System_2_3_10_aggregate" targetRef="System_2_3_10_load_inventory" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_10" sourceRef="System_2_3_10_load_inventory" targetRef="System_2_3_10_calculate_stock" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_11" sourceRef="System_2_3_10_calculate_stock" targetRef="System_2_3_10_save_inventory" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_12" sourceRef="System_2_3_10_save_inventory" targetRef="System_2_3_10_response" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_13" sourceRef="System_2_3_10_response" targetRef="System_2_3_10_result" />
    <bpmn:serviceTask id="System_2_3_10_calculate_stock" name="B2.4 Tính tồn kho mới sau khi trừ nguyên liệu" />
    <bpmn:serviceTask id="System_2_3_10_save_inventory" name="B3.4 Cập nhật tồn kho mới, cho phép số lượng âm" />
    <bpmn:serviceTask id="System_2_3_10_response" name="B2.5 Trả trạng thái đơn hàng đã cập nhật cho Frontend" />
    <bpmn:task id="System_2_3_10_result" name="B1.2 Hiển thị trạng thái đơn hàng đã cập nhật" />
    <bpmn:endEvent id="System_2_3_10_end" name="Đã cập nhật" />
    <bpmn:sequenceFlow id="System_2_3_10_Flow_14" sourceRef="System_2_3_10_result" targetRef="System_2_3_10_end" />
  </bpmn:process>
