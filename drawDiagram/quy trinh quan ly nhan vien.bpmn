  <bpmn:process id="Process_System_2_3_9" isExecutable="false">
    <bpmn:documentation>Khi admin hoặc manager mở trang quản lý nhân viên, Frontend gọi Backend lấy danh sách. Backend gọi Database; Database trả dữ liệu cho Backend và Backend trả danh sách cho Frontend hiển thị. Sau khi danh sách được hiển thị, quản trị viên mới chọn thao tác thêm, sửa hoặc xóa nhân viên.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_9">
      <bpmn:lane id="Lane_Frontend_2_3_9" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_9_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_list_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_operation_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_9" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_9_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_list_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_account_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_list_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Database_2_3_9" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_9_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_create_profile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_create_account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_9_delete</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
