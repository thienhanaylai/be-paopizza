  <bpmn:collaboration id="Collaboration_2_3_6">
    <bpmn:participant id="Participant_Actor_2_3_6" name="A&#10;Nhân viên / Quản lý" processRef="Process_Actor_2_3_6" />
    <bpmn:participant id="Participant_System_2_3_6" name="B&#10;Hệ thống PaoPizza" processRef="Process_System_2_3_6" />
    <bpmn:messageFlow id="Message_Open_Page_2_3_6" sourceRef="Actor_2_3_6_open" targetRef="System_2_3_6_start" />
    <bpmn:messageFlow id="Message_Select_Order_2_3_6" sourceRef="Actor_2_3_6_select" targetRef="System_2_3_6_select_request" />
    <bpmn:messageFlow id="Message_Order_Action_2_3_6" sourceRef="Actor_2_3_6_action" targetRef="System_2_3_6_action_request" />
    <bpmn:messageFlow id="Message_Response_2_3_6" sourceRef="System_2_3_6_result" targetRef="Actor_2_3_6_receive" />
