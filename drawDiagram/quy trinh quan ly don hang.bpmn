  <bpmn:process id="Process_Actor_2_3_6" isExecutable="false">
    <bpmn:startEvent id="Actor_2_3_6_start" name="Bắt đầu" />
    <bpmn:userTask id="Actor_2_3_6_open" name="A1 Mở trang quản lý đơn hàng" />
    <bpmn:userTask id="Actor_2_3_6_list" name="A2 Xem danh sách đơn hàng" />
    <bpmn:userTask id="Actor_2_3_6_select" name="A3 Chọn đơn hàng" />
    <bpmn:userTask id="Actor_2_3_6_action" name="A4 Xem hoặc cập nhật trạng thái đơn hàng" />
    <bpmn:userTask id="Actor_2_3_6_receive" name="A5 Xem thông tin đơn và trạng thái hiện tại" />
    <bpmn:endEvent id="Actor_2_3_6_end" name="Kết thúc" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_1" sourceRef="Actor_2_3_6_start" targetRef="Actor_2_3_6_open" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_2" sourceRef="Actor_2_3_6_open" targetRef="Actor_2_3_6_list" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_3" sourceRef="Actor_2_3_6_list" targetRef="Actor_2_3_6_select" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_4" sourceRef="Actor_2_3_6_select" targetRef="Actor_2_3_6_action" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_5" sourceRef="Actor_2_3_6_action" targetRef="Actor_2_3_6_receive" />
    <bpmn:sequenceFlow id="Actor_2_3_6_Flow_6" sourceRef="Actor_2_3_6_receive" targetRef="Actor_2_3_6_end" />
  </bpmn:process>
  <bpmn:process id="Process_System_2_3_6" isExecutable="false">
    <bpmn:documentation>Khi nhân viên hoặc quản lý mở trang quản lý đơn hàng, hệ thống tải và hiển thị danh sách. Người dùng chọn một đơn để xem hoặc cập nhật trạng thái. Nếu trạng thái mới là completed, hệ thống thực hiện trừ kho. Sau khi xử lý, hệ thống truy vấn lại đơn và hiển thị thông tin với trạng thái hiện tại.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_6">
      <bpmn:lane id="Lane_Database_2_3_6" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_6_load_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_update_inventory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_reload_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_load_list</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_6" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_6_auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_list_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_get_order_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_order_exists</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_order_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_update_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_completed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_deduct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_detail_response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Frontend_2_3_6" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_6_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_list_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_display_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_select_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_display_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_not_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_action_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_6_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="System_2_3_6_start" name="Nhận yêu cầu mở trang quản lý đơn">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_6_start" />
    </bpmn:startEvent>
    <bpmn:task id="System_2_3_6_list_request" name="B1.1 Gửi yêu cầu lấy danh sách đơn hàng" />
    <bpmn:serviceTask id="System_2_3_6_auth" name="B2.1 Xác thực nhân viên hoặc quản lý" />
    <bpmn:serviceTask id="System_2_3_6_list_response" name="B2.2 Trả danh sách đơn hàng" />
    <bpmn:task id="System_2_3_6_display_list" name="B1.2 Hiển thị danh sách đơn hàng" />
    <bpmn:intermediateCatchEvent id="System_2_3_6_select_request" name="Nhận đơn hàng được chọn">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_6_select_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="System_2_3_6_get_order_request" name="B2.3 Nhận yêu cầu truy vấn đơn hàng" />
    <bpmn:serviceTask id="System_2_3_6_load_order" name="B3.2 Truy vấn chi tiết đơn hàng" />
    <bpmn:exclusiveGateway id="System_2_3_6_order_exists" name="Có đơn hàng?" />
    <bpmn:serviceTask id="System_2_3_6_order_response" name="B2.4 Trả thông tin đơn hàng cho Frontend" />
    <bpmn:task id="System_2_3_6_display_order" name="B1.3 Hiển thị thông tin đơn hàng" />
    <bpmn:task id="System_2_3_6_not_found" name="B1.3.1 Thông báo không tìm thấy đơn hàng" />
    <bpmn:intermediateCatchEvent id="System_2_3_6_action_request" name="Nhận yêu cầu cập nhật trạng thái">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_6_action_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="System_2_3_6_update_request" name="B2.5 Kiểm tra và cập nhật trạng thái">
      <bpmn:incoming>System_2_3_6_Flow_10</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="System_2_3_6_update" name="B3.3 Lưu trạng thái mới của đơn hàng" />
    <bpmn:exclusiveGateway id="System_2_3_6_completed" name="Hoàn thành?" />
    <bpmn:serviceTask id="System_2_3_6_deduct" name="B2.6 Thực hiện quy trình trừ kho" />
    <bpmn:serviceTask id="System_2_3_6_update_inventory" name="B3.4 Cập nhật tồn kho nguyên liệu" />
    <bpmn:serviceTask id="System_2_3_6_reload_order" name="B3.5 Truy vấn lại đơn hàng vừa xử lý" />
    <bpmn:serviceTask id="System_2_3_6_detail_response" name="B2.7 Trả thông tin và trạng thái hiện tại" />
    <bpmn:task id="System_2_3_6_result" name="B1.4 Hiển thị lại thông tin đơn hàng với trạng thái hiện tại" />
    <bpmn:endEvent id="System_2_3_6_end" name="Đã xử lý" />
