  <bpmn:process id="Process_Actor_2_3_7" isExecutable="false">
    <bpmn:startEvent id="Actor_2_3_7_start" name="Bắt đầu" />
    <bpmn:userTask id="Actor_2_3_7_open" name="A1 Mở trang quản lý chuỗi cửa hàng" />
    <bpmn:userTask id="Actor_2_3_7_action" name="A2 Nhận và xem danh sách cửa hàng" />
    <bpmn:userTask id="Actor_2_3_7_operation" name="A3 Chọn thêm, sửa hoặc xóa cửa hàng" />
    <bpmn:userTask id="Activity_1ot76oh" name="A4 Nhập dữ liệu">
      <bpmn:incoming>Actor_2_3_7_Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_12rcyov</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Actor_2_3_7_receive" name="A5 Nhận kết quả cập nhật">
      <bpmn:incoming>Flow_12rcyov</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:endEvent id="Actor_2_3_7_end" name="Kết thúc" />
    <bpmn:sequenceFlow id="Actor_2_3_7_Flow_1" sourceRef="Actor_2_3_7_start" targetRef="Actor_2_3_7_open" />
