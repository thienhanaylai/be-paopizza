    <bpmn:serviceTask id="System_2_3_7_close" name="B3.4 Xóa cửa hàng bằng trạng thái close" />
    <bpmn:serviceTask id="System_2_3_7_update_response" name="B2.5 Nhận kết quả Database và trả về Frontend" />
    <bpmn:task id="System_2_3_7_update_result" name="B1.6 Hiển thị kết quả cập nhật" />
    <bpmn:endEvent id="System_2_3_7_end" name="Đã cập nhật" />
