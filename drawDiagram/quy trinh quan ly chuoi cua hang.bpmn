  </bpmn:process>
  <bpmn:process id="Process_System_2_3_7" isExecutable="false">
    <bpmn:documentation>Khi quản trị viên mở trang quản lý chuỗi cửa hàng, Frontend gọi Backend và Database lấy danh sách rồi hiển thị danh sách trước. Sau khi quản trị viên chọn thêm, sửa hoặc xóa, Frontend hiển thị form và gửi dữ liệu submit cho Backend kiểm tra. Nếu dữ liệu không hợp lệ, Frontend yêu cầu nhập lại; nếu hợp lệ, Database cập nhật dữ liệu.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_7">
      <bpmn:lane id="Lane_Database_2_3_7" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_7_list</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_crud</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_update</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_7" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_7_action</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_valid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_update_response</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Frontend_2_3_7" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_7_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_operation_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_form</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_reenter</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_update_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_7_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="System_2_3_7_start" name="Frontend nhận yêu cầu mở trang quản lý cửa hàng">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_7_start" />
    </bpmn:startEvent>
    <bpmn:task id="System_2_3_7_validate" name="B1.1 Gọi Backend lấy danh sách cửa hàng" />
    <bpmn:serviceTask id="System_2_3_7_action" name="B2.1 Nhận yêu cầu lấy danh sách cửa hàng" />
    <bpmn:serviceTask id="System_2_3_7_list" name="B3.1 Truy vấn danh sách cửa hàng và đếm nhân viên" />
    <bpmn:task id="System_2_3_7_result" name="B1.2 Hiển thị danh sách cửa hàng" />
    <bpmn:serviceTask id="System_2_3_7_response" name="B2.2 Nhận danh sách từ Database và trả về Frontend" />
    <bpmn:intermediateCatchEvent id="System_2_3_7_operation_request" name="B1.3 Frontend nhận yêu cầu thêm/sửa/xóa">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_7_operation_request" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="System_2_3_7_form" name="B1.4 Hiển thị form thêm/sửa/xóa cửa hàng" />
    <bpmn:serviceTask id="System_2_3_7_business" name="B2.3 Nhận dữ liệu submit và kiểm tra thông tin cửa hàng" />
    <bpmn:exclusiveGateway id="System_2_3_7_valid" name="Dữ liệu hợp lệ?" />
    <bpmn:task id="System_2_3_7_error" name="B2.4 Trả lỗi dữ liệu không hợp lệ" />
    <bpmn:task id="System_2_3_7_reenter" name="B1.5 Thông báo lỗi và yêu cầu nhập lại" />
