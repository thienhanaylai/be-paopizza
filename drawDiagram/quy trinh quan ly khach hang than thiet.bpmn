  <bpmn:collaboration id="Collaboration_2_3_8">
    <bpmn:participant id="Participant_Actor_2_3_8" name="A&#10;Quản trị viên" processRef="Process_Actor_2_3_8" />
    <bpmn:participant id="Participant_System_2_3_8" name="B&#10;Hệ thống PaoPizza" processRef="Process_System_2_3_8" />
    <bpmn:messageFlow id="Message_Request_2_3_8" sourceRef="Actor_2_3_8_open" targetRef="System_2_3_8_start" />
