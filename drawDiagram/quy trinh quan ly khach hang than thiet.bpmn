  </bpmn:collaboration>
  <bpmn:process id="Process_Actor_2_3_8" isExecutable="false">
    <bpmn:startEvent id="Actor_2_3_8_start" name="Bắt đầu" />
    <bpmn:userTask id="Actor_2_3_8_open" name="A1 Mở trang khách hàng thân thiết" />
    <bpmn:userTask id="Actor_2_3_8_action" name="A2 Xem danh sách và thống kê khách hàng" />
    <bpmn:userTask id="Actor_2_3_8_receive" name="A3 Nhận danh sách, điểm, hạng và lịch sử mua" />
    <bpmn:endEvent id="Actor_2_3_8_end" name="Kết thúc" />
    <bpmn:sequenceFlow id="Actor_2_3_8_Flow_1" sourceRef="Actor_2_3_8_start" targetRef="Actor_2_3_8_open" />
    <bpmn:sequenceFlow id="Actor_2_3_8_Flow_2" sourceRef="Actor_2_3_8_open" targetRef="Actor_2_3_8_action" />
    <bpmn:sequenceFlow id="Actor_2_3_8_Flow_3" sourceRef="Actor_2_3_8_action" targetRef="Actor_2_3_8_receive" />
    <bpmn:sequenceFlow id="Actor_2_3_8_Flow_4" sourceRef="Actor_2_3_8_receive" targetRef="Actor_2_3_8_end" />
  </bpmn:process>
  <bpmn:process id="Process_System_2_3_8" isExecutable="false">
    <bpmn:documentation>Khi quản trị viên mở trang khách hàng thân thiết, Frontend gọi Backend lấy danh sách. Backend gọi Database; Database trả dữ liệu khách hàng và đơn completed cho Backend tổng hợp, sau đó Backend trả danh sách cho Frontend hiển thị.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_8">
      <bpmn:lane id="Lane_Frontend_2_3_8" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_8_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_query</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_8" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_8_normalize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_stats</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_point_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_points</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_page</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Database_2_3_8" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_8_customers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_orders</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_8_tier</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="System_2_3_8_start" name="Frontend nhận yêu cầu xem danh sách khách hàng thân thiết">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_8_start" />
    </bpmn:startEvent>
    <bpmn:task id="System_2_3_8_query" name="B1.1 Gọi Backend lấy danh sách khách hàng thân thiết" />
    <bpmn:serviceTask id="System_2_3_8_normalize" name="B2.1 Nhận yêu cầu và gọi Database" />
    <bpmn:serviceTask id="System_2_3_8_customers" name="B3.1 Truy vấn danh sách khách hàng thân thiết" />
    <bpmn:serviceTask id="System_2_3_8_orders" name="B3.2 Tổng hợp các đơn completed theo khách hàng" />
    <bpmn:serviceTask id="System_2_3_8_stats" name="B2.2 Nhận dữ liệu Database và tổng hợp thống kê" />
    <bpmn:exclusiveGateway id="System_2_3_8_point_check" name="Có đơn mới hoàn tất?" />
    <bpmn:serviceTask id="System_2_3_8_points" name="B2.3 Cộng floor(tổng tiền/10.000) điểm" />
    <bpmn:serviceTask id="System_2_3_8_tier" name="B3.3 Cập nhật currentPoint, totalPoint và tier" />
    <bpmn:serviceTask id="System_2_3_8_page" name="B2.4 Trả danh sách khách hàng cho Frontend" />
    <bpmn:task id="System_2_3_8_result" name="B1.2 Nhận và hiển thị danh sách khách hàng thân thiết" />
    <bpmn:endEvent id="System_2_3_8_end" name="Đã hiển thị" />
    <bpmn:sequenceFlow id="System_2_3_8_Flow_1" sourceRef="System_2_3_8_start" targetRef="System_2_3_8_query" />
