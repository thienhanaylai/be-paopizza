        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n    %% ================= ENTITIES (Rectangles) =================\n    CART[Cart]\n    CATEGORY[Category]\n    CUSTOMER[Customer]\n    EMPLOYEE[Employee]\n    INGREDIENT[Ingredient]\n    INVENTORY[Inventory]\n    ORDER[Order]\n    PRODUCT[Product]\n    PROMOTION[Promotion]\n    STORE[Store]\n    SUPPLIER[Supplier]\n    USER[User]\n\n    %% ================= RELATIONSHIPS (Diamonds) =================\n    R_Cat_Pro{Contains}\n    CATEGORY --- R_Cat_Pro --- PRODUCT\n\n    R_Cus_Ord{Places}\n    CUSTOMER --- R_Cus_Ord --- ORDER\n\n    R_Usr_Cus{Linked To}\n    USER --- R_Usr_Cus --- CUSTOMER\n\n    R_Emp_Ord{Processes}\n    EMPLOYEE --- R_Emp_Ord --- ORDER\n\n    R_Sto_Man{Managed By}\n    STORE --- R_Sto_Man --- EMPLOYEE\n\n    R_Usr_Emp{Linked To}\n    USER --- R_Usr_Emp --- EMPLOYEE\n\n    R_Ing_Inv{Stocked In}\n    INGREDIENT --- R_Ing_Inv --- INVENTORY\n\n    R_Ing_Pro{Part Of}\n    INGREDIENT --- R_Ing_Pro --- PRODUCT\n\n    R_Pro_Car{Added To}\n    PRODUCT --- R_Pro_Car --- CART\n\n    R_Pro_Ord{Included In}\n    PRODUCT --- R_Pro_Ord --- ORDER\n\n    R_Emp_Sto{Works At}\n    EMPLOYEE --- R_Emp_Sto --- STORE\n\n    R_Sto_Inv{Has}\n    STORE --- R_Sto_Inv --- INVENTORY\n\n    R_Sto_Ord{Receives}\n    STORE --- R_Sto_Ord --- ORDER\n\n    R_Prm_Sto{Applies To}\n    PROMOTION --- R_Prm_Sto --- STORE\n\n    R_Usr_Car{Owns}\n    USER --- R_Usr_Car --- CART\n\n    %% ================= ATTRIBUTES (Ovals &amp; Arrows) =================\n    \n    %% CART\n    C_id([Id])\n    C_uid([UserId])\n    C_items([Items])\n    C_created([CreatedAt])\n    CART --&gt; C_id &amp; C_uid &amp; C_items &amp; C_created\n\n    %% CATEGORY\n    CAT_id([Id])\n    CAT_name([Name])\n    CAT_slug([Slug])\n    CAT_icon([Icon])\n    CAT_act([IsActive])\n    CATEGORY --&gt; CAT_id &amp; CAT_name &amp; CAT_slug &amp; CAT_icon &amp; CAT_act\n\n    %% CUSTOMER\n    CUS_id([Id])\n    CUS_name([Name])\n    CUS_phone([Phone])\n    CUS_email([Email])\n    CUS_add([Address])\n    CUS_point([Point])\n    CUSTOMER --&gt; CUS_id &amp; CUS_name &amp; CUS_phone &amp; CUS_email &amp; CUS_add &amp; CUS_point\n\n    %% EMPLOYEE\n    EMP_id([Id])\n    EMP_sid([StoreId])\n    EMP_name([Name])\n    EMP_phone([Phone])\n    EMP_email([Email])\n    EMP_sal([Salary])\n    EMP_stype([SalaryType])\n    EMP_sta([Station])\n    EMP_st([Status])\n    EMP_bank([BankAccount])\n    EMP_birth([Birthday])\n    EMPLOYEE --&gt; EMP_id &amp; EMP_sid &amp; EMP_name &amp; EMP_phone &amp; EMP_email &amp; EMP_sal &amp; EMP_stype &amp; EMP_sta &amp; EMP_st &amp; EMP_bank &amp; EMP_birth\n\n    %% INGREDIENT\n    ING_id([Id])\n    ING_name([Name])\n    ING_cat([Category])\n    ING_cost([CostPerUnit])\n    ING_unit([Unit])\n    ING_act([IsActive])\n    INGREDIENT --&gt; ING_id &amp; ING_name &amp; ING_cat &amp; ING_cost &amp; ING_unit &amp; ING_act\n\n    %% INVENTORY\n    INV_id([Id])\n    INV_sid([StoreId])\n    INV_ing([Ingredients])\n    INVENTORY --&gt; INV_id &amp; INV_sid &amp; INV_ing\n\n    %% ORDER\n    ORD_id([Id])\n    ORD_cid([CustomerId])\n    ORD_eid([EmployeeId])\n    ORD_sid([StoreId])\n    ORD_info([ContactInfo])\n    ORD_items([Items])\n    ORD_stot([SubTotal])\n    ORD_disc([DiscountAmount])\n    ORD_tot([Total])\n    ORD_type([OrderType])\n    ORD_st([Status])\n    ORD_payM([PaymentMethod])\n    ORD_payS([PaymentStatus])\n    ORD_note([Note])\n    ORDER --&gt; ORD_id &amp; ORD_cid &amp; ORD_eid &amp; ORD_sid &amp; ORD_info &amp; ORD_items &amp; ORD_stot &amp; ORD_disc &amp; ORD_tot &amp; ORD_type &amp; ORD_st &amp; ORD_payM &amp; ORD_payS &amp; ORD_note\n\n    %% PRODUCT\n    PRO_id([Id])\n    PRO_cat([CategoryId])\n    PRO_name([Name])\n    PRO_desc([Description])\n    PRO_var([Variants])\n    PRO_act([IsActive])\n    PRODUCT --&gt; PRO_id &amp; PRO_cat &amp; PRO_name &amp; PRO_desc &amp; PRO_var &amp; PRO_act\n\n    %% PROMOTION\n    PRM_id([Id])\n    PRM_code([Code])\n    PRM_type([Type])\n    PRM_val([Value])\n    PRM_app([ApplicableStore])\n    PRM_sd([StartDate])\n    PRM_ed([EndDate])\n    PRM_st([Status])\n    PROMOTION --&gt; PRM_id &amp; PRM_code &amp; PRM_type &amp; PRM_val &amp; PRM_app &amp; PRM_sd &amp; PRM_ed &amp; PRM_st\n\n    %% STORE\n    STO_id([Id])\n    STO_man([ManagerBy])\n    STO_name([Name])\n    STO_add([Address])\n    STO_phone([Phone])\n    STO_email([Email])\n    STO_topen([TimeOpen])\n    STO_tclose([TimeClose])\n    STO_st([Status])\n    STORE --&gt; STO_id &amp; STO_man &amp; STO_name &amp; STO_add &amp; STO_phone &amp; STO_email &amp; STO_topen &amp; STO_tclose &amp; STO_st\n\n    %% SUPPLIER\n    SUP_id([Id])\n    SUP_name([Name])\n    SUP_phone([Phone])\n    SUP_email([Email])\n    SUP_cat([SupplierCategory])\n    SUP_act([IsActive])\n    SUPPLIER --&gt; SUP_id &amp; SUP_name &amp; SUP_phone &amp; SUP_email &amp; SUP_cat &amp; SUP_act\n\n    %% USER\n    USR_id([Id])\n    USR_ref([RefId])\n    USR_name([Username])\n    USR_pass([Password])\n    USR_type([UserType])\n    USR_role([Role])\n    USR_st([Status])\n    USER --&gt; USR_id &amp; USR_ref &amp; USR_name &amp; USR_pass &amp; USR_type &amp; USR_role &amp; USR_st&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_K5udDauuPhJl5wE4MT6-1">
