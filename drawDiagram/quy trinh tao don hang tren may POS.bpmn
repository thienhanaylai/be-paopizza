  </bpmn:process>
  <bpmn:process id="Process_System_2_3_5" isExecutable="false">
    <bpmn:documentation>Sau khi nhân viên đăng nhập và mở POS, Frontend tiếp nhận yêu cầu và hiển thị menu. Hệ thống chờ khách hàng chọn món; khi nhân viên nhập và gửi thông tin đơn hợp lệ, Frontend mới gọi Backend. Backend kiểm tra nghiệp vụ, Database tạo đơn và Frontend hiển thị thông báo thành công.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_2_3_5">
      <bpmn:lane id="Lane_Frontend_2_3_5" name="B1&#10;Frontend">
        <bpmn:flowNodeRef>System_2_3_5_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_wait_order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_create_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_input</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_validate_ui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_valid_ui</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_ui_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_2_3_5" name="B2&#10;Backend">
        <bpmn:flowNodeRef>System_2_3_5_be_request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_valid_business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_business_error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_be_result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Database_2_3_5" name="B3&#10;Database">
        <bpmn:flowNodeRef>System_2_3_5_create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>System_2_3_5_db_result</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="System_2_3_5_start" name="Frontend nhận yêu cầu mở POS">
      <bpmn:messageEventDefinition id="MessageDef_System_2_3_5_start" />
    </bpmn:startEvent>
