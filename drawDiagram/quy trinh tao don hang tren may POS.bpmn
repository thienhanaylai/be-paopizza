  <bpmn:process id="Process_Actor_2_3_5" isExecutable="false">
    <bpmn:startEvent id="Actor_2_3_5_start" name="Bắt đầu" />
    <bpmn:userTask id="Actor_2_3_5_open" name="A1 Đăng nhập và mở màn hình POS" />
    <bpmn:userTask id="Actor_2_3_5_action" name="A2 Chờ khách hàng chọn món và yêu cầu order" />
    <bpmn:userTask id="Actor_2_3_5_input" name="A3 Nhập thông tin đơn hàng" />
    <bpmn:userTask id="Actor_2_3_5_receive" name="A4 Nhận thông báo tạo đơn thành công" />
    <bpmn:endEvent id="Actor_2_3_5_end" name="Kết thúc" />
    <bpmn:sequenceFlow id="Actor_2_3_5_Flow_1" sourceRef="Actor_2_3_5_start" targetRef="Actor_2_3_5_open" />
    <bpmn:sequenceFlow id="Actor_2_3_5_Flow_2" sourceRef="Actor_2_3_5_open" targetRef="Actor_2_3_5_action" />
    <bpmn:sequenceFlow id="Actor_2_3_5_Flow_3" sourceRef="Actor_2_3_5_action" targetRef="Actor_2_3_5_input" />
