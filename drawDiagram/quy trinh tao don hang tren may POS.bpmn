  <bpmn:collaboration id="Collaboration_2_3_5">
    <bpmn:participant id="Participant_Actor_2_3_5" name="A&#10;Nhân viên bán hàng" processRef="Process_Actor_2_3_5" />
    <bpmn:participant id="Participant_System_2_3_5" name="B&#10;Hệ thống PaoPizza" processRef="Process_System_2_3_5" />
